# ─────────────────────────────────────────────────────────────────────────
# Client-safe variables (NEXT_PUBLIC_*)
# These are inlined into the browser JS bundle at build time. Never put
# secrets, tokens, or API keys behind a NEXT_PUBLIC_ prefix.
# ─────────────────────────────────────────────────────────────────────────

# Public app URL used for canonical links and callback generation.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend API used only for the SDK's unguarded /claims/* endpoints, which
# require no credential. Credentialed requests (account creation/lookup)
# never call this from the browser — see server-only section below.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Chain/network selector used by the reference claim UI.
NEXT_PUBLIC_CRYPTO_NETWORK=stellar-testnet

# Per-network issuer for the USDC issued asset. USDC stays HIDDEN in the send
# form until an issuer is set for the active network (see lib/bridgelet.ts
# `supportedAssetCodes`), because the backend does not create a trustline for
# the ephemeral account yet — see SDK issue 5. Once trustline support lands,
# set the issuer below to offer USDC. Public addresses — safe behind NEXT_PUBLIC_.
# Testnet USDC issuer (Circle):
NEXT_PUBLIC_USDC_ISSUER_TESTNET=
# Mainnet USDC issuer (Circle):
NEXT_PUBLIC_USDC_ISSUER_MAINNET=

# Horizon endpoint the browser submits the sender's payment to (step 2 of the send
# flow). Defaults from NEXT_PUBLIC_CRYPTO_NETWORK when unset.
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# MSW fixtures (mocks/) are OFF by default so the app talks to the real SDK.
# Set to true only when you want the fully mocked demo API in `npm run dev`.
NEXT_PUBLIC_USE_MOCKS=false

# Human support destination shown on error fallback states.
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Experimental Freighter client-side sender signing for account creation.
# Defaults to disabled when unset: the SDK has no /accounts/prepare endpoint
# yet, so enabling it only adds a guaranteed-to-fail request to every send.
# Set to true to opt back into the experimental client-signing path.
NEXT_PUBLIC_ENABLE_FREIGHTER_SENDER_SIGNING=false

# ─────────────────────────────────────────────────────────────────────────
# Server-only variables
# Read only inside Next.js Route Handlers (app/api/**/route.ts). Never sent
# to the browser. Do NOT prefix these with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────────────

# bridgelet-sdk base URL used by server-side Route Handlers that proxy
# credentialed requests (account creation/lookup).
BRIDGELET_SDK_URL=http://localhost:4000

# bridgelet-sdk credential. Attached as `Authorization: Bearer` by
# app/api/accounts/*.ts route handlers, never exposed to client-side code.
BRIDGELET_SDK_TOKEN=

# Resend API key used by app/api/send-email/route.ts to send transactional
# email server-side.
RESEND_API_KEY=


# Controls both Playwright's own mocking AND whether
# frontend/lib/sdk/mocks/ intercepts server-side calls to BRIDGELET_SDK_URL
# (see frontend/lib/sdk/mocks/README.md). Defaults to true (mocked) when
# unset — set to "false" to require a real bridgelet-sdk instance at
# BRIDGELET_SDK_URL.
E2E_USE_MOCKS=true