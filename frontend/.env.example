# ─────────────────────────────────────────────────────────────────────────
# Client-safe variables (NEXT_PUBLIC_*)
# These are inlined into the browser JS bundle at build time. Never put
# secrets, tokens, or API keys behind a NEXT_PUBLIC_ prefix.
# ─────────────────────────────────────────────────────────────────────────

# Public URL of this frontend. Used for canonical links and to build the
# claim links shown to senders. In production this MUST match the SDK's
# CLAIM_BASE_URL so the link a recipient receives points at this app.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PUBLIC, browser-reachable URL of the bridgelet-sdk. The browser calls the
# SDK's unguarded /claims/* endpoints directly, so this URL must be reachable
# from the user's browser and the SDK must allow this origin via CORS.
# NOTE: the SDK listens on the port set in ITS OWN .env (3001 in our setup) —
# not 3000, which is this frontend. Credentialed requests (account
# creation/lookup) never use this URL from the browser; they go server-side
# through BRIDGELET_SDK_URL below.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Chain/network selector used by the reference claim UI.
NEXT_PUBLIC_CRYPTO_NETWORK=stellar-testnet

# Per-network issuer for the USDC issued asset. USDC stays HIDDEN in the send
# form until an issuer is set for the active network (see lib/bridgelet.ts
# `supportedAssetCodes`), because the backend does not create a trustline for
# the ephemeral account yet — see SDK issue 5. Once trustline support lands,
# set the issuer below to offer USDC. Public addresses — safe behind NEXT_PUBLIC_.
# Testnet USDC issuer (Circle):
NEXT_PUBLIC_USDC_ISSUER_TESTNET=
# Mainnet USDC issuer (Circle):
NEXT_PUBLIC_USDC_ISSUER_MAINNET=

# Horizon endpoint the browser submits the sender's payment to (step 2 of the send
# flow). Defaults from NEXT_PUBLIC_CRYPTO_NETWORK when unset.
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# MSW fixtures (mocks/) are OFF by default so the app talks to the real SDK.
# Set to true only when you want the fully mocked demo API in `npm run dev`.
NEXT_PUBLIC_USE_MOCKS=false

# ─────────────────────────────────────────────────────────────────────────
# Analytics (docs/analytics-spec.md §3.1, §9.1)
# ─────────────────────────────────────────────────────────────────────────

# Site domain registered with Plausible. While this is unset the Plausible
# script is never injected and every event is buffered in memory, then
# discarded (§9.1). Note that /claim/[token] strips the script entirely —
# docs/security-model.mdx (T-16) forbids third-party scripts there so a
# claim token cannot leak via Referer.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Self-hosted or proxied Plausible origin. Defaults to https://plausible.io.
NEXT_PUBLIC_PLAUSIBLE_API_HOST=

# Build/release version, reported as the §3.1 `app_version` field so event
# volume can be correlated to a deploy. Falls back to "unknown" when unset.
NEXT_PUBLIC_APP_VERSION=

# Local payload verification. Set to true to have lib/analytics.ts validate
# every tracked event against the §3.1 base-payload shape on the way out and
# report violations in the console, instead of only printing the payload and
# leaving the engineer to eyeball it against the spec by hand.
NEXT_PUBLIC_ANALYTICS_VERIFY=false

# Human support destination shown on error fallback states.
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Experimental Freighter client-side sender signing for account creation.
# Defaults to disabled when unset. Set to true to opt into client-side signing.
# Defaults to disabled when unset: the SDK has no /accounts/prepare endpoint
# yet, so enabling it only adds a guaranteed-to-fail request to every send.
# Set to true to opt back into the experimental client-signing path.
NEXT_PUBLIC_ENABLE_FREIGHTER_SENDER_SIGNING=false

# ─────────────────────────────────────────────────────────────────────────
# Server-only variables
# Read only inside Next.js Route Handlers (app/api/**/route.ts). Never sent
# to the browser. Do NOT prefix these with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────────────

# bridgelet-sdk base URL used by server-side Route Handlers that proxy
# credentialed requests (account creation/lookup). Server-to-server, so it
# may be an internal URL (e.g. http://localhost:3001 or a private address).
BRIDGELET_SDK_URL=http://localhost:3001

# bridgelet-sdk credential. Attached as `Authorization: Bearer` by
# app/api/accounts/*.ts route handlers, never exposed to client-side code.
# MUST be a single unbroken JWT line signed with the SDK's JWT_SECRET, or the
# SDK rejects the request with 401. Mint it from the SDK's own tooling.
BRIDGELET_SDK_TOKEN=

# Resend API key used by app/api/send-email/route.ts to send transactional
# email server-side. When unset, the route reports "email not configured"
# instead of failing.
RESEND_API_KEY=

# Verified sender address for transactional email. In production this must be
# an address on a domain you have verified with Resend (the default
# onboarding@resend.dev is a testing-only sender).
EMAIL_FROM="Bridgelet <no-reply@your-domain.example>"

# Optional reply-to and a fixed recipient override for support/testing.
EMAIL_REPLY_TO=
EMAIL_TO=


# Controls both Playwright's own mocking AND whether
# frontend/lib/sdk/mocks/ intercepts server-side calls to BRIDGELET_SDK_URL
# (see frontend/lib/sdk/mocks/README.md). Defaults to true (mocked) when
# unset — set to "false" to require a real bridgelet-sdk instance at
# BRIDGELET_SDK_URL.
E2E_USE_MOCKS=true
